FROM python:3.12-slim
WORKDIR /app

# ffmpeg is required by mux_service.py
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY . .
ENV PORT=8080
# See the PYTHONPATH explanation in Dockerfile.api — same reason (keeps both
# services, which share the backend/ codebase, consistent).
ENV PYTHONPATH=/app
CMD exec uvicorn worker.main:app --host 0.0.0.0 --port ${PORT} --timeout-keep-alive 3600
