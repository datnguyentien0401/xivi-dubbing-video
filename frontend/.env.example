# Copy this to .env.local (already gitignored) and fill in real Firebase
# config from the Firebase Console so sign-in/Firestore realtime actually work.
#
# If NOT filled in (or this file is missing when running `npm run dev`
# directly, outside docker-compose): frontend/src/lib/firebase.ts calling
# `getAuth()` with an empty apiKey will throw immediately at module load time
# (`auth/invalid-api-key`) — crashing the entire React app before it renders,
# showing a blank page. The placeholder value below is only enough to pass the
# SDK's validation step so the app does NOT crash — it is not real config, the
# "Sign in" button won't work until it's replaced with a real Firebase
# project.

VITE_FIREBASE_API_KEY=local-dev-placeholder-key
VITE_FIREBASE_AUTH_DOMAIN=localhost
VITE_FIREBASE_PROJECT_ID=xivi-dev

# URL of the `api` service (backend/api) — the default matches running
# `npm run dev` directly on the machine while the backend also runs directly
# (no Docker).
VITE_API_BASE_URL=http://localhost:8000
