# --- Google Cloud ---
GOOGLE_CLOUD_PROJECT=xivi-dev
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
GEMINI_API_KEY=

# --- Database ---
DATABASE_URL=postgresql+asyncpg://xivi:xivi@localhost:5432/xivi

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Pub/Sub ---
PUBSUB_TOPIC_AGENT_EVENTS=agent-events
PUBSUB_PUSH_AUDIENCE=https://xivi-worker-xxxxx.a.run.app/pubsub/push

# --- Storage ---
GCS_BUCKET_NAME=xivi-media

# --- Firebase ---
FIREBASE_PROJECT_ID=xivi-dev

# Only set to "true" when running local dev and Login.tsx has not yet implemented
# real Google Sign-In (skips verifying the Firebase ID token, uses a fixed
# user instead) — see api/core/firebase_auth.py. MUST NOT be set to true in a real deploy.
AUTH_DEV_BYPASS=false
